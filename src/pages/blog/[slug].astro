---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { blogData, type BlogPost } from '../../data/blogData';
import { siteData } from '../../data/siteData';

export function getStaticPaths() {
  return blogData.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const breadcrumbs = [
  { name: "المقالات والنصائح", url: "/blog" },
  { name: post.title, url: `/blog/${post.slug}` }
];

const relatedPosts = blogData.filter(p => p.slug !== post.slug).slice(0, 3);
---

<MainLayout
  title={`${post.title} | فني مطابخ الدمام`}
  description={post.excerpt}
  image={post.image}
  type="article"
  articleMeta={{
    publishDate: post.publishDate,
    author: post.author,
    tags: post.tags
  }}
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Article Header -->
  <header class="article-header">
    <div class="container container-narrow">
      <div class="article-meta-top">
        <span class="article-cat-badge">{post.category}</span>
        <span class="meta-item">{post.publishDate}</span>
        <span class="meta-dot">•</span>
        <span class="meta-item">مدة القراءة: {post.readTime}</span>
      </div>

      <h1 class="article-main-title">{post.title}</h1>
      <p class="article-excerpt-lead">{post.excerpt}</p>

      <div class="article-author-strip">
        <div class="author-avatar">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </div>
        <div class="author-details">
          <span class="author-name">كتب بواسطة: {post.author}</span>
          <span class="author-role">خبير صيانة وتركيب مطابخ بالدمام والخبر</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Featured Image -->
  <div class="container container-narrow article-hero-img-wrap">
    <img src={post.image} alt={post.title} class="article-featured-img" />
  </div>

  <!-- Article Content & Sidebar -->
  <div class="container container-narrow article-body-container">
    <div class="article-content" set:html={post.content} />

    <!-- Tags -->
    <div class="article-tags-wrap">
      <span class="tags-label">الكلمات الدلالية:</span>
      <div class="tags-list">
        {post.tags.map(tag => (
          <span class="tag-pill">#{tag}</span>
        ))}
      </div>
    </div>

    <!-- Direct CTA Box Inside Article -->
    <div class="article-cta-box">
      <div class="cta-inner-text">
        <h3>هل تحتاج لمساعدة فنية في مطبخك بالدمام؟</h3>
        <p>لا تتردد في استشارة الفني أو طلب معاينة ميدانية لمطبخك اليوم بأسعار مناسبة وضمان شامل.</p>
      </div>
      <div class="cta-inner-actions">
        <a href={`tel:${siteData.phoneInternational}`} class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <span>اتصال: {siteData.phoneDisplay}</span>
        </a>
        <a href={siteData.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
          <span>تواصل واتساب</span>
        </a>
      </div>
    </div>

    <!-- Related Articles -->
    <div class="related-section">
      <h3 class="related-title">مقالات أخرى قد تهمك:</h3>
      <div class="grid-3 related-grid">
        {relatedPosts.map(rel => (
          <div class="related-card">
            <a href={`/blog/${rel.slug}`} class="rel-img-link">
              <img src={rel.image} alt={rel.title} loading="lazy" />
            </a>
            <div class="rel-body">
              <h4>
                <a href={`/blog/${rel.slug}`}>{rel.title}</a>
              </h4>
              <span class="rel-date">{rel.publishDate}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .article-header {
    background: #FFFFFF;
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.875rem;
    color: var(--color-text-light);
    margin-bottom: 1.25rem;
  }

  .article-cat-badge {
    background: var(--color-primary-light);
    color: var(--color-primary-hover);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .meta-dot {
    color: #CBD5E1;
  }

  .article-main-title {
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    line-height: 1.35;
    color: var(--color-dark);
    margin-bottom: 1.25rem;
  }

  .article-excerpt-lead {
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  .article-author-strip {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-dark);
  }

  .author-role {
    font-size: 0.825rem;
    color: var(--color-text-light);
  }

  .article-hero-img-wrap {
    margin-block: 1rem 3rem;
  }

  .article-featured-img {
    width: 100%;
    height: 450px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .article-body-container {
    padding-bottom: 5rem;
  }

  /* Rich Article Typography */
  .article-content {
    font-size: 1.1rem;
    line-height: 1.9;
    color: var(--color-text);
  }

  .article-content :global(h2) {
    font-size: 1.65rem;
    color: var(--color-dark);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .article-content :global(h3) {
    font-size: 1.35rem;
    color: var(--color-dark);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .article-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .article-content :global(ul), .article-content :global(ol) {
    margin-bottom: 1.75rem;
    padding-right: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.65rem;
  }

  .article-content :global(strong) {
    color: var(--color-dark);
  }

  .article-content :global(a) {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: underline;
  }

  .article-tags-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .tags-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-dark);
  }

  .tags-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    background: var(--color-surface-alt);
    color: var(--color-text-muted);
    font-size: 0.85rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  /* In-Article CTA Box */
  .article-cta-box {
    background: linear-gradient(135deg, var(--color-dark), var(--color-dark-light));
    color: #FFFFFF;
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    margin-block: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border: 1px solid rgba(197, 168, 128, 0.4);
    box-shadow: var(--shadow-xl);
  }

  .cta-inner-text h3 {
    color: #FFFFFF;
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .cta-inner-text p {
    color: #CBD5E1;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .cta-inner-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  /* Related Posts */
  .related-section {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .related-title {
    font-size: 1.45rem;
    margin-bottom: 1.75rem;
    color: var(--color-dark);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .related-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .rel-img-link {
    display: block;
    height: 140px;
    overflow: hidden;
  }

  .rel-img-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rel-body {
    padding: 1rem;
  }

  .rel-body h4 {
    font-size: 0.95rem;
    line-height: 1.45;
    margin-bottom: 0.5rem;
  }

  .rel-body a {
    color: var(--color-dark);
  }

  .rel-body a:hover {
    color: var(--color-primary);
  }

  .rel-date {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  @media (max-width: 768px) {
    .article-featured-img {
      height: 250px;
    }
    .article-cta-box {
      flex-direction: column;
      text-align: center;
    }
    .cta-inner-actions {
      flex-direction: column;
      width: 100%;
    }
    .cta-inner-actions .btn {
      width: 100%;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
