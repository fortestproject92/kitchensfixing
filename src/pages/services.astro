---
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { servicesData } from "../data/servicesData";
import { siteData } from "../data/siteData";

const breadcrumbs = [{ name: "خدماتنا", url: "/services" }];
---

<MainLayout
  title="خدمات تركيب وصيانة وفك المطابخ بالدمام | فني مطابخ 0535486325"
  description="دليل خدمات المطابخ المتكاملة في الدمام: تركيب مطابخ تفصيل وجاهزة، صيانة مطابخ المنيوم وخشب، قص وتعديل رخام ومجالي، تبديل مفصلات هيدروليك وسحابات أدراج، فك ونقل وتعديل مقاسات الدواليب."
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Page Header -->
  <section class="page-header">
    <div class="container text-center">
      <span class="section-badge">خدمات فنية متكاملة</span>
      <h1 class="page-title">خدمات تركيب وصيانة وفك المطابخ في الدمام</h1>
      <p class="page-lead">
        نقدم لك باقة شاملة من الخدمات الحرفية المتخصصة بأحدث الأجهزة الليزرية
        وقطع الغيار الأصلية مع ضمان معتمد في كافة أحياء الدمام والخبر والمنطقة
        الشرقية.
      </p>
    </div>
  </section>

  <!-- Services Detailed List -->
  <section class="section services-detail-section">
    <div class="container">
      <div class="services-list-container">
        {
          servicesData.map((service, index) => (
            <article class="service-detail-item" id={service.id}>
              <div
                class={`service-detail-grid ${index % 2 === 1 ? "reverse" : ""}`}
              >
                <div class="service-img-column">
                  <img
                    src={service.image}
                    alt={service.title}
                    class="service-full-img"
                    loading="lazy"
                  />
                  <div class="service-pricing-badge">
                    <strong>{service.startingPrice}</strong>
                  </div>
                </div>

                <div class="service-text-column">
                  <span class="service-step-num">0{index + 1}</span>
                  <h2 class="service-detail-title">{service.title}</h2>
                  <p class="service-detail-desc">{service.fullDesc}</p>

                  <div class="service-specs-box">
                    <h3 class="specs-title">مميزات وضمانات الخدمة:</h3>
                    <ul class="specs-list">
                      {service.features.map((feat) => (
                        <li>
                          <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="var(--color-primary)"
                            stroke-width="2.5"
                          >
                            <polyline points="20 6 9 17 4 12" />
                          </svg>
                          <span>{feat}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="service-detail-actions">
                    <a
                      href={`https://wa.me/966535486325?text=${encodeURIComponent(`السلام عليكم، أود حجز أو الاستفسار عن: ${service.title} في الدمام`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-whatsapp"
                    >
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.963.54 1.761.884 2.796.885h.005c3.179 0 5.765-2.587 5.765-5.766 0-3.18-2.586-5.771-5.77-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.072-2.18-.543-1.637-.677-2.673-2.339-2.755-2.449-.079-.109-.652-.868-.652-1.652 0-.784.411-1.17.558-1.328.146-.159.32-.198.427-.198.106 0 .213.002.307.006.1.006.234-.038.366.279.136.327.464 1.134.505 1.217.041.082.069.178.014.288-.055.109-.083.178-.165.274-.082.096-.173.214-.247.288-.082.083-.169.172-.072.337.096.166.428.705.918 1.141.632.562 1.164.737 1.33.82.165.083.262.069.359-.041.097-.11.412-.48.522-.646.11-.166.22-.138.371-.083.152.055.962.454 1.127.536.165.083.275.124.316.193.041.07.041.405-.103.81z" />
                      </svg>
                      <span>طلب هذه الخدمة واتساب</span>
                    </a>

                    <a
                      href={`tel:${siteData.phoneInternational}`}
                      class="btn btn-secondary"
                    >
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                      </svg>
                      <span>اتصال بالفني</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="cta-banner-section">
    <div class="container text-center">
      <h2 class="cta-banner-title">هل لديك استفسار أو طلب خاص لمطبخك؟</h2>
      <p class="cta-banner-desc">
        فني المطابخ بالدمام جاهز لمساعدتك وإعطائك أفضل الحلول الهندسية والجمالية
        بأسعار تنافسية.
      </p>
      <div class="cta-banner-actions">
        <a
          href={`tel:${siteData.phoneInternational}`}
          class="btn btn-lg btn-primary">اتصل الآن: {siteData.phoneDisplay}</a
        >
        <a
          href={siteData.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-lg btn-whatsapp">محادثة واتساب سريعة</a
        >
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .page-header {
    background: linear-gradient(
      135deg,
      var(--color-dark),
      var(--color-dark-light)
    );
    color: #ffffff;
    padding-block: 4.5rem 4rem;
    border-bottom: 3px solid var(--color-primary);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: #cbd5e1;
    max-width: 780px;
    margin-inline: auto;
    line-height: 1.7;
  }

  .services-detail-section {
    background: var(--color-bg);
  }

  .services-list-container {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .service-detail-item {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .service-detail-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 3rem;
    align-items: center;
  }

  .service-detail-grid.reverse {
    grid-template-columns: 1.25fr 1fr;
  }

  .service-detail-grid.reverse .service-img-column {
    order: 2;
  }

  .service-detail-grid.reverse .service-text-column {
    order: 1;
  }

  .service-img-column {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .service-full-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
  }

  .service-pricing-badge {
    position: absolute;
    bottom: 16px;
    right: 16px;
    background: rgba(4, 17, 38, 0.9);
    backdrop-filter: blur(8px);
    color: #ffffff;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
    font-size: 0.95rem;
    border: 1px solid rgba(197, 168, 128, 0.4);
  }

  .service-pricing-badge strong {
    color: var(--color-accent-gold);
    font-size: 1.05rem;
  }

  .service-step-num {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 900;
    color: rgba(197, 168, 128, 0.35);
    line-height: 1;
    display: block;
    margin-bottom: 0.25rem;
  }

  .service-detail-title {
    font-size: 1.75rem;
    color: var(--color-dark);
    margin-bottom: 1rem;
  }

  .service-detail-desc {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .service-specs-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .specs-title {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: var(--color-dark);
  }

  .specs-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  .specs-list li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.95rem;
    color: var(--color-dark);
    font-weight: 500;
  }

  .service-detail-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-banner-section {
    background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-dark-light) 100%);
    color: #ffffff;
    padding-block: 4rem;
    border-top: 1px solid var(--color-gold-border);
    border-bottom: 1px solid var(--color-gold-border);
  }

  .cta-banner-title {
    font-size: 2.2rem;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .cta-banner-desc {
    color: var(--color-accent-gold);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .cta-banner-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-banner-actions .btn-primary {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: #041126;
    font-weight: 800;
  }

  .cta-banner-actions .btn-primary:hover {
    background: linear-gradient(135deg, var(--color-primary-hover), #927140);
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .service-detail-grid,
    .service-detail-grid.reverse {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .service-detail-grid.reverse .service-img-column {
      order: 1;
    }
    .service-detail-grid.reverse .service-text-column {
      order: 2;
    }
    .service-detail-item {
      padding: 1.5rem;
    }
    .service-full-img {
      height: 260px;
    }
  }

  @media (max-width: 768px) {
    .page-header {
      padding-block: 3.5rem 2.5rem;
      text-align: center;
    }
    .service-detail-actions {
      flex-direction: column;
    }
    .service-detail-actions .btn {
      width: 100%;
      justify-content: center;
    }
    .cta-banner-actions {
      flex-direction: column;
      align-items: center;
    }
    .cta-banner-actions .btn {
      width: 100%;
      max-width: 360px;
      justify-content: center;
    }
  }
</style>
