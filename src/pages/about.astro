---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteData } from '../data/siteData';

const breadcrumbs = [
  { name: "من نحن والتعريف بالعمل", url: "/about" }
];
---

<MainLayout
  title="التعريف بالعمل ومن نحن | فني تركيب وصيانة مطابخ الدمام"
  description="تعرف على فني مطابخ الدمام: أكثر من 12 عاماً من الخبرة والاحتراف في تركيب وصيانة وفك المطابخ وتعديل مقاسات الدواليب وقص الرخام بالمنطقة الشرقية."
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Page Header -->
  <section class="page-header">
    <div class="container text-center">
      <span class="section-badge">خبرة تتحدث عن نفسها</span>
      <h1 class="page-title">من نحن والتعريف بخدماتنا في الدمام</h1>
      <p class="page-lead">
        رواد صيانة وتركيب وفك المطابخ في مدينة الدمام والخبر؛ نجمع بين الحرفية اليدوية الدقيقة وأحدث الأجهزة الهندسية لنمنحك مطبخاً متيناً وأنيقاً يدوم لسنوات.
      </p>
    </div>
  </section>

  <!-- About Story Section -->
  <section class="section about-story-section">
    <div class="container">
      <div class="grid-2 story-grid">
        <div class="story-img-card">
          <img src="/images/kitchen-installation.jpg" alt="فني تركيب مطابخ الدمام أثناء العمل" class="story-main-img" />
          <div class="exp-badge">
            <span class="exp-years">+12</span>
            <span class="exp-text">عاماً من الخبرة الميدانية في الشرقية</span>
          </div>
        </div>

        <div class="story-content">
          <span class="section-badge">قصة النجاح والشغف</span>
          <h2 class="section-title">فني مطابخ معتمد ومحترف بالدمام</h2>
          <p class="story-p">
            بدأت مسيرتنا المهنية في المنطقة الشرقية منذ أكثر من 12 عاماً، ركزنا خلالها على إتقان أدق تفاصيل المطابخ الألمنيوم والخشبية والكلادينج. نحن نؤمن بأن المطبخ ليس مجرد خزائن لتخزين الأواني، بل هو المساحة الأهم التي تقضي فيها العائلة أوقاتها اليومية.
          </p>
          <p class="story-p">
            مع التطور السريع في تصاميم المطابخ والمفصلات الهيدروليكية وتقنيات الرخام الكوارتز، حرصنا دائماً على مواكبة أحدث أدوات الوزن الليزري ومناشير القص المائي المتقنة لتقديم أعمال بمواصفات تضاهي أكبر شركات المطابخ العالمية، ولكن بأسعار محلية مباشرة ومناسبة للجميع.
          </p>

          <div class="story-highlights">
            <div class="highlight-item">
              <span class="hl-icon">✓</span>
              <span>تنفيذ أكثر من 1,200 مشروع مطبخ بنجاح بالدمام والخبر</span>
            </div>
            <div class="highlight-item">
              <span class="hl-icon">✓</span>
              <span>التعامل المباشر مع صاحب العمل الفني بدون وسطاء أو شركات تسويق</span>
            </div>
            <div class="highlight-item">
              <span class="hl-icon">✓</span>
              <span>التزام صارم بنظافة المكان وتسليم المطبخ جاهزاً للاستخدام فوراً</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="section values-section">
    <div class="container">
      <div class="section-title-wrap">
        <span class="section-badge">مبادئنا المهنية</span>
        <h2 class="section-title">القيم التي نبني عليها ثقة عملائنا</h2>
        <p class="section-desc">نحرص في كل مهمة نوكل بها على تطبيق أعلى معايير الجودة والنزاهة والأمانة</p>
      </div>

      <div class="grid-3 values-grid">
        <div class="value-card">
          <div class="value-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <h3 class="value-title">الأمانة والقطع الأصلية</h3>
          <p class="value-desc">نستخدم دائماً المفصلات الهيدروليكية الإيطالية وسحابات الأدراج الأصلية ونقدم للعميل فواتير وضمانات معتمدة على كافة قطع الغيار.</p>
        </div>

        <div class="value-card">
          <div class="value-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <h3 class="value-title">احترام الوقت والمواعيد</h3>
          <p class="value-desc">ندرك تماماً أهمية المطبخ لربة المنزل؛ لذلك نلتزم بإنهاء أعمال الصيانة أو الفك والتركيب في الوقت المتفق عليه دون تأخير.</p>
        </div>

        <div class="value-card">
          <div class="value-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <h3 class="value-title">التسعيرة العادلة والشفافة</h3>
          <p class="value-desc">نقدم عرض سعر دقيق بعد المعاينة الميدانية بدون أي رسوم خفية أو تكاليف غير مبررة، وهدفنا رضا العميل قبل أي شيء.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Official Brand Identity & Accreditation -->
  <section class="section brand-identity-section">
    <div class="container">
      <div class="grid-2 brand-identity-grid">
        <div class="brand-card-img-wrap">
          <img src="/images/fani-matabikh-dammam.jpg" alt="بطاقة وهوية فني صيانة مطابخ الدمام الرسمية" class="brand-card-img" />
        </div>
        <div class="brand-card-info">
          <span class="section-badge">هويتنا واعتمادنا المهني</span>
          <h2 class="section-title">فني صيانة مطابخ الدمام المعتمد</h2>
          <p class="story-p">
            نعتز بهويتنا المهنية وسمعتنا الراسخة كأفضل فني صيانة وتركيب وتعديل مطابخ في كافة مدن ومحافظات المنطقة الشرقية. بطاقتنا الرسمية وشعارنا يمثلان ميثاق الجودة والأمانة مع كل عميل يثق في خدماتنا.
          </p>
          <div class="brand-creds-list">
            <div class="brand-cred-item">
              <span class="cred-tag">الهاتف المباشر</span>
              <span dir="ltr">0535486325</span>
            </div>
            <div class="brand-cred-item">
              <span class="cred-tag">المنطقة والمدينة</span>
              <span>المملكة العربية السعودية، الدمام والمنطقة الشرقية</span>
            </div>
            <div class="brand-cred-item">
              <span class="cred-tag">الموقع الرسمي</span>
              <span dir="ltr">www.kitchenrepair.com</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Connect with Technician Direct -->
  <section class="section direct-contact-section">
    <div class="container text-center">
      <div class="contact-box-inner">
        <h2 class="direct-title">تواصل مباشرة مع فني المطابخ بالدمام</h2>
        <p class="direct-desc">
          تفضل بالاتصال أو المحادثة عبر الواتساب للاستفسار، حجز موعد للمعاينة، أو طلب عرض سعر مجاني.
        </p>
        <div class="direct-phone-display" dir="ltr">{siteData.phoneDisplay}</div>
        <div class="direct-actions">
          <a href={`tel:${siteData.phoneInternational}`} class="btn btn-lg btn-primary">اتصال هاتفي مباشر</a>
          <a href={siteData.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-whatsapp">محادثة واتساب فورية</a>
          <a href={siteData.instagramUrl} target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path></svg>
            <span>انستغرام المعلم</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-dark), var(--color-dark-light));
    color: #FFFFFF;
    padding-block: 4.5rem 4rem;
    border-bottom: 3px solid var(--color-primary);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #FFFFFF;
    margin-bottom: 1rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: #CBD5E1;
    max-width: 780px;
    margin-inline: auto;
    line-height: 1.7;
  }

  .about-story-section {
    background: #FFFFFF;
  }

  .story-grid {
    align-items: center;
    gap: 3.5rem;
  }

  .story-img-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .story-main-img {
    width: 100%;
    height: 440px;
    object-fit: cover;
  }

  .exp-badge {
    position: absolute;
    bottom: 24px;
    right: 24px;
    background: var(--color-dark);
    color: #FFFFFF;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-md);
    border-right: 4px solid var(--color-primary);
    box-shadow: var(--shadow-lg);
  }

  .exp-years {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 900;
    color: var(--color-accent-gold);
    line-height: 1;
  }

  .exp-text {
    font-size: 0.85rem;
    color: #CBD5E1;
  }

  .story-p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }

  .story-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1.75rem;
    background: var(--color-bg);
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--color-dark);
    font-weight: 600;
  }

  .hl-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .values-section {
    background: var(--color-surface-alt);
  }

  .value-card {
    background: #FFFFFF;
    padding: 2.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
  }

  .value-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .value-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: var(--color-primary-light);
    color: var(--color-primary-hover);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .value-title {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .value-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .direct-contact-section {
    background: #FFFFFF;
  }

  .contact-box-inner {
    max-width: 720px;
    margin-inline: auto;
    background: linear-gradient(135deg, var(--color-dark), var(--color-dark-light));
    color: #FFFFFF;
    padding: 3rem 2rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    border: 2px solid rgba(197, 168, 128, 0.4);
  }

  .direct-title {
    color: #FFFFFF;
    font-size: 1.85rem;
    margin-bottom: 0.75rem;
  }

  .direct-desc {
    color: #CBD5E1;
    font-size: 1.05rem;
    margin-bottom: 1.5rem;
  }

  .direct-phone-display {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--color-accent-gold);
    margin-bottom: 2rem;
    letter-spacing: 2px;
  }

  .direct-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
    .story-main-img {
      height: 280px;
    }
    .direct-phone-display {
      font-size: 1.85rem;
    }
  }

  .brand-identity-section {
    background: var(--color-surface-alt);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .brand-identity-grid {
    align-items: center;
    gap: 3.5rem;
  }

  .brand-card-img-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 2px solid var(--color-gold-border);
    background: var(--color-dark);
  }

  .brand-card-img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--transition-normal);
  }

  .brand-card-img-wrap:hover .brand-card-img {
    transform: scale(1.02);
  }

  .brand-creds-list {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .brand-cred-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    background: #FFFFFF;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    font-weight: 600;
  }

  .cred-tag {
    background: var(--color-primary-light);
    color: var(--color-primary-hover);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .page-header {
      padding-block: 3.5rem 2.5rem;
      text-align: center;
    }
    .story-content {
      text-align: center;
    }
    .story-content .section-badge {
      margin-inline: auto;
    }
    .brand-card-info {
      text-align: center;
    }
    .brand-card-info .section-badge {
      margin-inline: auto;
    }
    .brand-cred-item {
      justify-content: center;
      text-align: center;
      flex-wrap: wrap;
    }
  }
</style>
