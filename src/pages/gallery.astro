---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { galleryData } from '../data/galleryData';
import { siteData } from '../data/siteData';

const breadcrumbs = [
  { name: "معرض الأعمال", url: "/gallery" }
];
---

<MainLayout
  title="معرض أعمال مطابخ الدمام | صور مشاريع تركيب وصيانة وفك المطابخ"
  description="شاهد بالصور أحدث مشاريع تركيب وصيانة وفك وتجديد المطابخ الألمنيوم والخشب وقص أسطح الرخام التي نفذناها في أحياء الدمام والخبر والظهران."
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Page Header -->
  <section class="page-header">
    <div class="container text-center">
      <span class="section-badge">سابقة أعمال حقيقية</span>
      <h1 class="page-title">معرض أعمال ومشاريع المطابخ بالدمام</h1>
      <p class="page-lead">
        تصفح تشكيلة من أحدث المطابخ التي قمنا بتركيبها وصيانتها وتجديد واجهاتها وأسطح الرخام في مختلف أحياء الدمام والخبر. صور حقيقية تعكس جودة واحترافية عملنا.
      </p>
    </div>
  </section>

  <!-- Gallery Section with Interactive Filter -->
  <section class="section gallery-full-section">
    <div class="container">
      <!-- Filter Tabs -->
      <div class="gallery-filters" id="galleryFilters">
        <button class="filter-btn active" data-filter="all">جميع الأعمال</button>
        <button class="filter-btn" data-filter="installation">تركيب مطابخ جديدة</button>
        <button class="filter-btn" data-filter="maintenance">صيانة ومفصلات</button>
        <button class="filter-btn" data-filter="marble">رخام ومجالي</button>
        <button class="filter-btn" data-filter="custom">تجديد وجزر وسطية</button>
      </div>

      <!-- Gallery Grid -->
      <div class="gallery-grid" id="galleryGrid">
        {galleryData.map(item => (
          <div class="gallery-item-card" data-category={item.category}>
            <div class="item-img-wrap">
              <img src={item.image} alt={item.title} loading="lazy" />
              <span class="item-category-tag">{item.categoryName}</span>
            </div>
            <div class="item-content">
              <div class="item-meta">
                <span class="item-location">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  {item.location}
                </span>
              </div>
              <h3 class="item-title">{item.title}</h3>
              <p class="item-desc">{item.description}</p>
              
              <div class="item-tags">
                {item.tags.map(tag => (
                  <span class="item-tag">#{tag}</span>
                ))}
              </div>

              <div class="item-card-action">
                <a
                  href={`https://wa.me/966535486325?text=${encodeURIComponent(`السلام عليكم، شاهدت هذا المشروع في معرض أعمالكم (${item.title}) وأرغب في تنفيذ عمل مماثل لمطبخي في الدمام.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-sm btn-whatsapp"
                  style="width: 100%;"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.963.54 1.761.884 2.796.885h.005c3.179 0 5.765-2.587 5.765-5.766 0-3.18-2.586-5.771-5.77-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.072-2.18-.543-1.637-.677-2.673-2.339-2.755-2.449-.079-.109-.652-.868-.652-1.652 0-.784.411-1.17.558-1.328.146-.159.32-.198.427-.198.106 0 .213.002.307.006.1.006.234-.038.366.279.136.327.464 1.134.505 1.217.041.082.069.178.014.288-.055.109-.083.178-.165.274-.082.096-.173.214-.247.288-.082.083-.169.172-.072.337.096.166.428.705.918 1.141.632.562 1.164.737 1.33.82.165.083.262.069.359-.041.097-.11.412-.48.522-.646.11-.166.22-.138.371-.083.152.055.962.454 1.127.536.165.083.275.124.316.193.041.07.041.405-.103.81z"/>
                  </svg>
                  <span>أريد مطبخاً مماثلاً لهذا العمل</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Box -->
  <section class="cta-banner-section">
    <div class="container text-center">
      <h2 class="cta-banner-title">هل لديك تصميم خاص أو صورة مطبخ ترغب في تنفيذها؟</h2>
      <p class="cta-banner-desc">أرسل لنا الصورة أو المقاسات عبر الواتساب وسنوافيك بدراسة التكلفة وطريقة التنفيذ فوراً.</p>
      <div class="cta-banner-actions">
        <a href={siteData.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-whatsapp">أرسل صورة مطبخك عبر الواتساب</a>
        <a href={`tel:${siteData.phoneInternational}`} class="btn btn-lg btn-primary">اتصل الآن: {siteData.phoneDisplay}</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-dark), var(--color-dark-light));
    color: #FFFFFF;
    padding-block: 4.5rem 4rem;
    border-bottom: 3px solid var(--color-primary);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #FFFFFF;
    margin-bottom: 1rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: #CBD5E1;
    max-width: 780px;
    margin-inline: auto;
    line-height: 1.7;
  }

  .gallery-full-section {
    background: var(--color-bg);
  }

  .gallery-filters {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .filter-btn {
    background: #FFFFFF;
    border: 1.5px solid var(--color-border);
    color: var(--color-dark);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.65rem 1.35rem;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #041126;
    font-weight: 800;
    box-shadow: 0 4px 12px rgba(197, 168, 128, 0.45);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .gallery-item-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-normal);
    display: flex;
    flex-direction: column;
  }

  .gallery-item-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-xl);
  }

  .item-img-wrap {
    position: relative;
    height: 250px;
    overflow: hidden;
  }

  .item-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .gallery-item-card:hover .item-img-wrap img {
    transform: scale(1.06);
  }

  .item-category-tag {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(15, 23, 42, 0.85);
    color: var(--color-accent-gold);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
    backdrop-filter: blur(6px);
  }

  .item-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .item-location {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .item-title {
    font-size: 1.25rem;
    margin-bottom: 0.65rem;
    line-height: 1.4;
  }

  .item-desc {
    color: var(--color-text-muted);
    font-size: 0.925rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    flex: 1;
  }

  .item-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .item-tag {
    font-size: 0.8rem;
    color: #64748B;
    background: var(--color-surface-alt);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .cta-banner-section {
    background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-dark-light) 100%);
    color: #FFFFFF;
    padding-block: 4rem;
    border-top: 1px solid var(--color-gold-border);
    border-bottom: 1px solid var(--color-gold-border);
  }

  .cta-banner-title {
    font-size: 2.2rem;
    color: #FFFFFF;
    margin-bottom: 0.75rem;
  }

  .cta-banner-desc {
    color: var(--color-accent-gold);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .cta-banner-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-banner-actions .btn-primary {
    background: var(--color-dark);
    color: #FFFFFF;
  }

  @media (max-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.gallery-item-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Toggle active state
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      cards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
