---
import { siteData } from '../data/siteData';
---

<div class="floating-actions" aria-label="أزرار التواصل السريع">
  <!-- Desktop & Tablet Floating Buttons -->
  <div class="floating-btn-group">
    <!-- Call Button -->
    <a
      href={`tel:${siteData.phoneInternational}`}
      class="float-btn float-call"
      aria-label="اتصال هاتف مباشر بالفني"
      title="اتصال هاتفي مباشر"
    >
      <div class="float-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
      </div>
      <span class="float-tooltip">اتصل بالفني: {siteData.phoneDisplay}</span>
    </a>

    <!-- WhatsApp Button with Pulse -->
    <a
      href={siteData.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="float-btn float-whatsapp animate-pulse-ring"
      aria-label="محادثة واتساب مباشرة"
      title="محادثة واتساب فورية"
    >
      <div class="float-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.963.54 1.761.884 2.796.885h.005c3.179 0 5.765-2.587 5.765-5.766 0-3.18-2.586-5.771-5.77-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.072-2.18-.543-1.637-.677-2.673-2.339-2.755-2.449-.079-.109-.652-.868-.652-1.652 0-.784.411-1.17.558-1.328.146-.159.32-.198.427-.198.106 0 .213.002.307.006.1.006.234-.038.366.279.136.327.464 1.134.505 1.217.041.082.069.178.014.288-.055.109-.083.178-.165.274-.082.096-.173.214-.247.288-.082.083-.169.172-.072.337.096.166.428.705.918 1.141.632.562 1.164.737 1.33.82.165.083.262.069.359-.041.097-.11.412-.48.522-.646.11-.166.22-.138.371-.083.152.055.962.454 1.127.536.165.083.275.124.316.193.041.07.041.405-.103.81z"/>
        </svg>
      </div>
      <span class="float-tooltip">تواصل واتساب فوري</span>
    </a>
  </div>

  <!-- Mobile Bottom Sticky Bar -->
  <div class="mobile-sticky-bar">
    <a href={`tel:${siteData.phoneInternational}`} class="mobile-bar-btn mobile-call-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
      <span>اتصال مباشر</span>
    </a>

    <a href={siteData.whatsappUrl} target="_blank" rel="noopener noreferrer" class="mobile-bar-btn mobile-whatsapp-btn">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.963.54 1.761.884 2.796.885h.005c3.179 0 5.765-2.587 5.765-5.766 0-3.18-2.586-5.771-5.77-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.072-2.18-.543-1.637-.677-2.673-2.339-2.755-2.449-.079-.109-.652-.868-.652-1.652 0-.784.411-1.17.558-1.328.146-.159.32-.198.427-.198.106 0 .213.002.307.006.1.006.234-.038.366.279.136.327.464 1.134.505 1.217.041.082.069.178.014.288-.055.109-.083.178-.165.274-.082.096-.173.214-.247.288-.082.083-.169.172-.072.337.096.166.428.705.918 1.141.632.562 1.164.737 1.33.82.165.083.262.069.359-.041.097-.11.412-.48.522-.646.11-.166.22-.138.371-.083.152.055.962.454 1.127.536.165.083.275.124.316.193.041.07.041.405-.103.81z"/>
      </svg>
      <span>محادثة واتساب</span>
    </a>
  </div>
</div>

<style>
  .floating-btn-group {
    position: fixed;
    bottom: 2.5rem;
    left: 2rem;
    z-index: 99;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .float-btn {
    position: relative;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    transition: all var(--transition-fast);
  }

  .float-btn:hover {
    transform: scale(1.1);
  }

  .float-whatsapp {
    background: var(--color-whatsapp);
  }

  .float-whatsapp:hover {
    background: var(--color-whatsapp-hover);
  }

  .float-call {
    background: var(--color-call);
  }

  .float-call:hover {
    background: var(--color-call-hover);
  }

  .float-tooltip {
    position: absolute;
    right: 70px;
    top: 50%;
    transform: translateY(-50%);
    background: var(--color-dark);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-fast);
    box-shadow: var(--shadow-md);
  }

  .float-tooltip::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -6px;
    transform: translateY(-50%);
    border-width: 6px 0 6px 6px;
    border-style: solid;
    border-color: transparent transparent transparent var(--color-dark);
  }

  .float-btn:hover .float-tooltip {
    opacity: 1;
  }

  /* Mobile Sticky Bottom Bar */
  .mobile-sticky-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 99;
    background: #FFFFFF;
    padding: 0.65rem 1rem;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
    border-top: 1px solid var(--color-border);
    gap: 0.75rem;
  }

  .mobile-bar-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem;
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .mobile-call-btn {
    background: var(--color-call);
  }

  .mobile-whatsapp-btn {
    background: var(--color-whatsapp);
  }

  @media (max-width: 768px) {
    .floating-btn-group {
      display: none;
    }

    .mobile-sticky-bar {
      display: flex;
    }

    /* Add padding to body to prevent mobile bar from covering content */
    :global(body) {
      padding-bottom: 70px;
    }
  }
</style>
